# --- LLM (free) ---
# Sign up at: https://console.groq.com
# NOTE: check https://console.groq.com/docs/deprecations before relying on these —
# Groq deprecates models on short notice (llama-3.3-70b-versatile and the old vision
# model below were both deprecated 2026-06-17).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Vision model for captionless figures and scanned pages (same API key)
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# --- LLM Fallback (optional) ---
# Sign up at: https://aistudio.google.com
# Free tier is capped at 20 requests/day per model — exhausts fast under any real load.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- LLM Primary for graph extraction + answer generation (recommended) ---
# Sign up at: https://openrouter.ai — routes through a third, separately-billed
# provider so Groq/Gemini quota exhaustion doesn't take down the whole app.
OPENROUTER_API_KEY=
GRAPH_MODEL=google/gemini-2.5-flash-lite
ANSWER_MODEL=google/gemini-2.5-flash

# --- Vector Database (free) ---
# Sign up at: https://cloud.qdrant.io
QDRANT_URL=
QDRANT_API_KEY=

# --- Redis cache (optional, free) ---
# Sign up at: https://upstash.com — create a Redis database, copy the URL
REDIS_URL=rediss://default:<token>@<host>.upstash.io:6379

# --- Semantic cache (optional) ---
# Cosine similarity floor for a cache hit (0-1). Below this, falls through to the LLM.
SEMANTIC_CACHE_THRESHOLD=0.93
# Max hot entries kept in-process across ALL users combined (bounded, not per-user —
# keeps memory predictable on small instances).
SEMANTIC_CACHE_L1_MAX=500
# Max cached entries kept per user in Redis.
SEMANTIC_CACHE_PER_USER_MAX=50

# --- Supabase ---
# Dashboard: https://supabase.com/dashboard
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# --- Model cache (optional) ---
# Local path to cache fastembed embedding/reranker models (avoids re-download)
FASTEMBED_CACHE_PATH=/tmp/fastembed_cache
